@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>本地访问设置</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="my-6">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        系统账号密码入口已关闭。请在“配置与审计”中查看本地模式、执行器配置和审计记录。
    </MudAlert>
    <MudButton Href="/AutomationConfigAudit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Settings"
               Class="mt-3">
        前往配置与审计
    </MudButton>
</MudContainer>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Navigation.NavigateTo("/AutomationConfigAudit", replace: true);
        }
    }
}
