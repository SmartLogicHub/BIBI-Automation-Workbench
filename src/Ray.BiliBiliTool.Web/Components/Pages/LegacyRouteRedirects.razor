@inject NavigationManager Navigation

<PageTitle>正在打开</PageTitle>

@code {
    protected override void OnInitialized()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/')
            .ToLowerInvariant();
        var target = path switch
        {
            "login" => "/accounts",
            "productcomment" or "templatelibrary" or "configurations/productcommenttaskconfig" => "/comment-ops",
            "taskrecords" => "/records",
            "admin" or "automationconfigaudit" or "datamanagement" => "/settings",
            _ => "/workflows"
        };
        Navigation.NavigateTo(target, replace: true);
    }
}
