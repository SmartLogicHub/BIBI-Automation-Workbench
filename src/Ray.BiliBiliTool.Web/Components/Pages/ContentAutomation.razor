    private void ApplyStrategy(ContentAutomationStrategy strategy)
    {
        _commentMode = strategy.CommentMode;
        _keywordsText = string.Join(Environment.NewLine, strategy.Keywords);
        _selectedAccountIds = strategy.AccountIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
        _workflow.LibraryId = strategy.LibraryId.StartsWith("__AI__", StringComparison.OrdinalIgnoreCase) ? "" : strategy.LibraryId;
        _workflow.Rules = strategy.Rules;
        _workflow.Year = strategy.Year;
        _workflow.Limit = strategy.SearchLimit;
        _workflow.MaxCount = strategy.PublishLimit;
        _workflow.DurationMinutes = strategy.DurationMinutes;
        _workflow.CycleIntervalMinutes = strategy.CycleIntervalMinutes;
        _workflow.CycleIntervalSeconds = strategy.CycleIntervalSeconds;
        _workflow.AccountIntervalMinSeconds = strategy.AccountIntervalMinSeconds;
        _workflow.AccountIntervalMaxSeconds = strategy.AccountIntervalMaxSeconds;
        _workflow.SameAccountCooldownMinSeconds = strategy.SameAccountCooldownMinSeconds;
        _workflow.SameAccountCooldownMaxSeconds = strategy.SameAccountCooldownMaxSeconds;
        _workflow.CommentMode = strategy.CommentMode;
        ApplyTimingValuesFromStrategy(strategy);
    }

    private void ApplyTimingValuesFromStrategy(ContentAutomationStrategy strategy)
    {
        _accountIntervalUnit = PreferredDurationUnit(strategy.AccountIntervalMinSeconds, strategy.AccountIntervalMaxSeconds);
        _accountIntervalMinValue = SecondsToDuration(strategy.AccountIntervalMinSeconds, _accountIntervalUnit);
        _accountIntervalMaxValue = SecondsToDuration(strategy.AccountIntervalMaxSeconds, _accountIntervalUnit);
        _sameAccountCooldownUnit = PreferredDurationUnit(strategy.SameAccountCooldownMinSeconds, strategy.SameAccountCooldownMaxSeconds);
        _sameAccountCooldownMinValue = SecondsToDuration(strategy.SameAccountCooldownMinSeconds, _sameAccountCooldownUnit);
        _sameAccountCooldownMaxValue = SecondsToDuration(strategy.SameAccountCooldownMaxSeconds, _sameAccountCooldownUnit);
        _cycleIntervalUnit = PreferredDurationUnit(strategy.CycleIntervalSeconds);
        _cycleIntervalValue = SecondsToDuration(strategy.CycleIntervalSeconds, _cycleIntervalUnit);
    }

    private void ApplyTimingValuesToWorkflow()
    {
        _workflow.AccountIntervalMinSeconds = DurationToSeconds(_accountIntervalMinValue, _accountIntervalUnit);
        _workflow.AccountIntervalMaxSeconds = Math.Max(
            _workflow.AccountIntervalMinSeconds,
            DurationToSeconds(_accountIntervalMaxValue, _accountIntervalUnit));
        _workflow.SameAccountCooldownMinSeconds = DurationToSeconds(_sameAccountCooldownMinValue, _sameAccountCooldownUnit);
        _workflow.SameAccountCooldownMaxSeconds = Math.Max(
            _workflow.SameAccountCooldownMinSeconds,
            DurationToSeconds(_sameAccountCooldownMaxValue, _sameAccountCooldownUnit));
        _workflow.CycleIntervalSeconds = DurationToSeconds(_cycleIntervalValue, _cycleIntervalUnit);
        _workflow.CycleIntervalMinutes = Math.Max(1, (int)Math.Ceiling(_workflow.CycleIntervalSeconds / 60d));
    }

    private static int DurationToSeconds(decimal value, string unit)
    {
        var factor = NormalizeDurationUnit(unit) == "minutes" ? 60m : 1m;
        return Math.Clamp((int)Math.Round(value * factor, MidpointRounding.AwayFromZero), 1, 86_400);
    }

    private static decimal SecondsToDuration(int seconds, string unit) =>
        NormalizeDurationUnit(unit) == "minutes"
            ? Math.Round(Math.Max(1, seconds) / 60m, 4)
            : Math.Max(1, seconds);

    private static string PreferredDurationUnit(params int[] values) =>
        values.Length > 0 && values.All(value => value >= 60 && value % 60 == 0) ? "minutes" : "seconds";

    private static string NormalizeDurationUnit(string unit) =>
        unit.Equals("minutes", StringComparison.OrdinalIgnoreCase) ? "minutes" : "seconds";

    private static decimal DurationInputMin(string unit) =>
        NormalizeDurationUnit(unit) == "minutes" ? 1m / 60m : 1m;

    private static decimal DurationInputMax(string unit) =>
        NormalizeDurationUnit(unit) == "minutes" ? 1_440m : 86_400m;

    private void OnRuntimeChanged(SystemRuntimeState state)
    {
        var becameReady = !_runtime.IsReady && state.IsReady;
        _runtime = state;
        _ = InvokeAsync(async () =>
        {
            if (becameReady)
                await LoadOperationalDataAsync();
            else
                StateHasChanged();
        });
    }

    private void SetMessage(string message, Severity severity)
    {
        _message = message;
        _messageSeverity = severity;
    }

    private static List<string> Lines(string value) => (value ?? "").Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Where(item => item.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    private static bool IsStatus(string value, string expected) => string.Equals(value?.Trim(), expected, StringComparison.OrdinalIgnoreCase);
    private static bool IsSuccess(string value) => value?.Trim().ToLowerInvariant() is "success" or "done" or "completed";
    private static bool IsTerminal(string value) => value?.Trim().ToLowerInvariant() is "done" or "success" or "completed" or "failed" or "error" or "stopped" or "timeout" or "manual_required";
    private static string VideoTitle(ContentAutomationVideo video) => string.IsNullOrWhiteSpace(video.Title) ? video.Bvid : video.Title;
    private static string AccountDisplayName(ContentAutomationAccount account) => string.IsNullOrWhiteSpace(account.Nickname) ? account.Name : account.Nickname;
    private static string AccountOptionLabel(ContentAutomationAccount account) =>
        $"{AccountDisplayName(account)}（{(AutomationAccountSelection.IsAvailable(account) ? "可用" : "需要登录")}）";
    private static DateTimeOffset ParseTime(string value) => DateTimeOffset.TryParse(value, out var time) ? time : DateTimeOffset.MinValue;
    private static string FormatTime(string value) => DateTimeOffset.TryParse(value, out var time) ? (time.LocalDateTime.Date == DateTime.Today ? time.LocalDateTime.ToString("HH:mm") : time.LocalDateTime.ToString("MM-dd HH:mm")) : "";
    private static bool HasPlatformProof(ContentAutomationLedgerRecord item) =>
        IsSuccess(item.Status) && item.VerificationMethod?.Trim().ToLowerInvariant() is "comment_visible" or "success_notice";
    private static bool IsPendingConfirmation(ContentAutomationLedgerRecord item) =>
        item.Status?.Trim().ToLowerInvariant() == "submitted_unverified";
    private static string EvidenceTime(ContentAutomationLedgerRecord item) =>
        !string.IsNullOrWhiteSpace(item.VerifiedAt) ? item.VerifiedAt
        : !string.IsNullOrWhiteSpace(item.PublishedAt) ? item.PublishedAt
        : item.CreatedAt;
    private static string VideoUrl(ContentAutomationLedgerRecord item) =>
        !string.IsNullOrWhiteSpace(item.VideoUrl) ? item.VideoUrl
        : !string.IsNullOrWhiteSpace(item.Bvid) ? $"https://www.bilibili.com/video/{item.Bvid}" : "#";
    private static string LedgerStatusText(ContentAutomationLedgerRecord item) =>
        HasPlatformProof(item) ? "平台已确认"
        : IsPendingConfirmation(item) ? "待核验"
        : IsSuccess(item.Status) ? "历史记录"
        : item.Status?.Trim().ToLowerInvariant() == "skipped" ? "已跳过"
        : "未完成";
    private static string LedgerStatusClass(ContentAutomationLedgerRecord item) =>
        HasPlatformProof(item) ? "bibi-status-chip--success"
        : IsPendingConfirmation(item) || IsSuccess(item.Status) || item.Status?.Trim().ToLowerInvariant() == "skipped" ? "bibi-status-chip--warning"
        : "bibi-status-chip--danger";
    private static string LedgerProofTitle(ContentAutomationLedgerRecord item) =>
        HasPlatformProof(item) ? "站内结果已核验"
        : IsPendingConfirmation(item) ? "等待人工核验"
        : IsSuccess(item.Status) ? "历史记录无站内凭证"
        : item.Status?.Trim().ToLowerInvariant() == "skipped" ? "本次没有提交"
        : "发布未完成";
    private static string LedgerProofDescription(ContentAutomationLedgerRecord item) =>
        !string.IsNullOrWhiteSpace(item.ProofText) ? item.ProofText
        : !string.IsNullOrWhiteSpace(item.ErrorMessage) ? item.ErrorMessage
        : IsSuccess(item.Status) ? "该记录由旧版本生成，无法证明评论仍在站内。"
        : "未获得可核验的页面结果。";
    private static string LedgerProofClass(ContentAutomationLedgerRecord item) =>
        HasPlatformProof(item) ? "is-confirmed" : IsPendingConfirmation(item) || IsSuccess(item.Status) ? "is-pending" : "is-failed";
    private static string LedgerProofIcon(ContentAutomationLedgerRecord item) =>
        HasPlatformProof(item) ? Icons.Material.Outlined.Verified
        : IsPendingConfirmation(item) || IsSuccess(item.Status) ? Icons.Material.Outlined.Schedule
        : Icons.Material.Outlined.ErrorOutline;
    private static string EventTitle(ContentAutomationJobEvent? item) => item is null ? "等待任务启动" : item.Status?.Trim().ToLowerInvariant() is "error" or "failed" ? "需要处理" : item.EventType?.Trim().ToLowerInvariant() == "warning" ? "已跳过一项" : "任务进度";
    private static string EventMessage(ContentAutomationJobEvent? item) => item is null || string.IsNullOrWhiteSpace(item.Message) ? "运行状态会自动更新。" : item.Message;
    private static string EventClass(ContentAutomationJobEvent item) => item.Status?.Trim().ToLowerInvariant() is "error" or "failed" ? "event-item__dot--error" : item.EventType?.Trim().ToLowerInvariant() == "warning" ? "event-item__dot--warning" : "";

    public ValueTask DisposeAsync()
    {
        RuntimeStateStore.Changed -= OnRuntimeChanged;
        StopPolling();
        return ValueTask.CompletedTask;
    }

    private sealed record DraftPreview(string VideoId, string Video, string Comment, string Source);
}
