    private async Task ImportLibraryFilesAsync(InputFileChangeEventArgs args)
    {
        _isBusy = true;
        try
        {
            var selectedFiles = args.GetMultipleFiles(200)
                .Where(file => string.Equals(Path.GetExtension(file.Name), ".txt", StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (selectedFiles.Count == 0)
            {
                Snackbar.Add("所选文件夹中没有文本词库。", Severity.Warning);
                return;
            }

            var files = new List<ContentAutomationLibraryImportFile>();
            foreach (var file in selectedFiles.Where(file => file.Size <= 2 * 1024 * 1024))
            {
                await using var stream = file.OpenReadStream(2 * 1024 * 1024);
                using var reader = new StreamReader(stream, detectEncodingFromByteOrderMarks: true);
                files.Add(new ContentAutomationLibraryImportFile
                {
                    RelativeName = file.Name,
                    Content = await reader.ReadToEndAsync()
                });
            }

            if (files.Count == 0)
            {
                Snackbar.Add("词库文件过大或无法读取，请检查后重试。", Severity.Warning);
                return;
            }

            var importedNames = files
                .Select(file => Path.GetFileNameWithoutExtension(file.RelativeName))
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            var result = await AutomationBridge.ImportLibrariesFromFilesAsync(files);
            if (!result.Success || result.Imported <= 0)
            {
                Snackbar.Add("词库未能导入，请检查文件内容后重试。", Severity.Error);
                return;
            }

            _libraries = (await AutomationBridge.GetLibrariesAsync()).ToList();
            var importedLibrary = _libraries.FirstOrDefault(library => importedNames.Contains(library.Name));
            if (importedLibrary is not null)
            {
                _commentMode = "template";
                _workflow.LibraryId = importedLibrary.Id;
            }
            Snackbar.Add($"已导入 {result.Imported} 个词库，并选中 {importedLibrary?.Name ?? "新词库"}。", Severity.Success);
        }
        catch (InvalidOperationException)
        {
            Snackbar.Add("一次最多导入 200 个文本文件。", Severity.Warning);
        }
        catch
        {
            Snackbar.Add("词库导入失败，请检查文件内容后重试。", Severity.Error);
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

